@page "/"
<PageTitle>Clash Hub · Choose a game</PageTitle>

<main class="landing-page">
    <header class="landing-heading">
        <div class="eyebrow"><span class="eyebrow-dot"></span> PLAYER LOOKUP</div>
        <h1>Choose a game</h1>
        <p>Select a game to view a player profile and their stats.</p>
    </header>

    <section class="game-chooser" aria-label="Choose a game">
        <a class="game-choice coc-choice" href="/clash-of-clans">
            <span class="choice-top"><span class="choice-icon">COC</span><span class="choice-arrow">→</span></span>
            <span class="choice-copy"><strong>Clash of Clans</strong><span>Town Hall, trophies, clan, heroes and troops.</span></span>
        </a>
        <a class="game-choice royale-choice" href="/clash-royale">
            <span class="choice-top"><span class="choice-icon">CR</span><span class="choice-arrow">→</span></span>
            <span class="choice-copy"><strong>Clash Royale</strong><span>Arena, trophies, battle stats, badges and deck.</span></span>
        </a>
    </section>
</main>
