@page "/"
@rendermode InteractiveServer
@using System.Text.Json
@using SOA_CA1_DylanSmyth.Services
@inject ClashOfClansApi ClashApi
@inject ClashRoyaleApi RoyaleApi

<PageTitle>Player lookup</PageTitle>

<main class="workspace">
    <header class="page-header">
        <div>
            <div class="eyebrow"><span class="eyebrow-dot"></span> SUPERCELL API IMPORTER</div>
            <h1>Player lookup</h1>
            <p class="subtitle">Load public player profiles from Clash of Clans and Clash Royale.</p>
        </div>
    </header>

    <section class="source-grid" aria-label="API sources">
        <article class="source-card">
            <div class="card-topline">
                <div class="source-icon">COC</div>
                <div class="source-title"><span class="source-kicker">SOURCE 01</span><h2>Player profile</h2></div>
                <span class="status-pill @(player is not null ? "status-ready" : playerError is not null ? "status-error" : "status-idle")">
                    <span class="status-dot"></span>@(player is not null ? "Loaded" : playerError is not null ? "Error" : "Ready")
                </span>
            </div>

            <label class="field-label" for="player-tag">Player tag</label>
            <div class="endpoint-row">
                <span class="method-tag">#</span>
                <input id="player-tag" class="endpoint-input" @bind="playerTag" @bind:event="oninput"
                       placeholder="2ABC123" @onkeydown="HandlePlayerKeyDown" />
            </div>
            <div class="card-actions">
                <button class="connect-button" @onclick="LoadPlayerAsync" disabled="@playerLoading">
                    @if (playerLoading) { <span class="spinner"></span><span>Loading…</span> }
                    else { <span>↗</span><span>@(player is null ? "Load player" : "Refresh player")</span> }
                </button>
            </div>

            @if (playerError is not null) { <div class="error-message" role="alert">@playerError</div> }
            @if (player is not null)
            {
                <div class="player-summary">
                    <div class="player-name">@GetString(player.Value, "name") <span>@GetString(player.Value, "tag")</span></div>
                    <div class="stats-grid">
                        <div class="stat"><span>Town Hall</span><strong>@GetValue(player.Value, "townHallLevel")</strong></div>
                        <div class="stat"><span>Experience</span><strong>@GetValue(player.Value, "expLevel")</strong></div>
                        <div class="stat"><span>Trophies</span><strong>@GetValue(player.Value, "trophies")</strong></div>
                        <div class="stat"><span>Best trophies</span><strong>@GetValue(player.Value, "bestTrophies")</strong></div>
                    </div>
                    <div class="preview-heading"><span>PLAYER DATA</span><span>JSON</span></div>
                    <pre class="json-preview"><code>@JsonSerializer.Serialize(player.Value, jsonOptions)</code></pre>
                </div>
            }
            else if (!playerLoading)
            {
                <div class="empty-preview"><span class="empty-symbol">#</span><span>Enter a player tag to load their profile</span></div>
            }
        </article>

        <article class="source-card">
            <div class="card-topline">
                <div class="source-icon">CR</div>
                <div class="source-title"><span class="source-kicker">SOURCE 02</span><h2>Clash Royale player</h2></div>
                <span class="status-pill @(royalePlayer is not null ? "status-ready" : royaleError is not null ? "status-error" : "status-idle")">
                    <span class="status-dot"></span>@(royalePlayer is not null ? "Loaded" : royaleError is not null ? "Error" : "Ready")
                </span>
            </div>
            <label class="field-label" for="royale-tag">Player tag</label>
            <div class="endpoint-row">
                <span class="method-tag">#</span>
                <input id="royale-tag" class="endpoint-input" @bind="royaleTag" @bind:event="oninput"
                       placeholder="2ABC123" @onkeydown="HandleRoyaleKeyDown" />
            </div>
            <div class="card-actions">
                <button class="connect-button" @onclick="LoadRoyalePlayerAsync" disabled="@royaleLoading">
                    @if (royaleLoading) { <span class="spinner"></span><span>Loading…</span> }
                    else { <span>↗</span><span>@(royalePlayer is null ? "Load player" : "Refresh player")</span> }
                </button>
            </div>
            @if (royaleError is not null) { <div class="error-message" role="alert">@royaleError</div> }
            @if (royalePlayer is not null)
            {
                <div class="player-summary">
                    <div class="player-name">@GetString(royalePlayer.Value, "name") <span>@GetString(royalePlayer.Value, "tag")</span></div>
                    <div class="stats-grid">
                        <div class="stat"><span>Trophies</span><strong>@GetValue(royalePlayer.Value, "trophies")</strong></div>
                        <div class="stat"><span>Best trophies</span><strong>@GetValue(royalePlayer.Value, "bestTrophies")</strong></div>
                        <div class="stat"><span>Wins</span><strong>@GetValue(royalePlayer.Value, "wins")</strong></div>
                        <div class="stat"><span>Battle count</span><strong>@GetValue(royalePlayer.Value, "battleCount")</strong></div>
                    </div>
                    <div class="preview-heading"><span>PLAYER DATA</span><span>JSON</span></div>
                    <pre class="json-preview"><code>@JsonSerializer.Serialize(royalePlayer.Value, jsonOptions)</code></pre>
                </div>
            }
            else if (!royaleLoading)
            {
                <div class="empty-preview"><span class="empty-symbol">#</span><span>Enter a Clash Royale player tag</span></div>
            }
        </article>
    </section>
    <footer class="workspace-footer"><span class="footer-check">i</span><span>Player tags are public profile identifiers. API key requests are made securely by the server.</span></footer>
</main>

@code {
    private string playerTag = string.Empty;
    private JsonElement? player;
    private bool playerLoading;
    private string? playerError;
    private string royaleTag = string.Empty;
    private JsonElement? royalePlayer;
    private bool royaleLoading;
    private string? royaleError;
    private static readonly JsonSerializerOptions jsonOptions = new() { WriteIndented = true };

    private async Task LoadPlayerAsync()
    {
        playerError = null;
        player = null;
        playerLoading = true;
        try { player = await ClashApi.GetPlayerAsync(playerTag); }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException or HttpRequestException or TaskCanceledException)
        { playerError = ex.Message; }
        finally { playerLoading = false; }
    }

    private async Task HandlePlayerKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await LoadPlayerAsync();
    }

    private async Task HandleRoyaleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await LoadRoyalePlayerAsync();
    }

    private async Task LoadRoyalePlayerAsync()
    {
        royaleError = null;
        royalePlayer = null;
        royaleLoading = true;
        try { royalePlayer = await RoyaleApi.GetPlayerAsync(royaleTag); }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException or HttpRequestException or TaskCanceledException)
        { royaleError = ex.Message; }
        finally { royaleLoading = false; }
    }

    private static string GetString(JsonElement element, string property) =>
        element.TryGetProperty(property, out var value) ? value.ToString() : "Unknown player";

    private static string GetValue(JsonElement element, string property) =>
        element.TryGetProperty(property, out var value) ? value.ToString() : "—";
}
