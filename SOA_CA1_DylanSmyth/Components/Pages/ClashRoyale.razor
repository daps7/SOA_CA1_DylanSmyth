@page "/clash-royale"
@rendermode InteractiveServer
@using System.Text.Json
@using SOA_CA1_DylanSmyth.Services
@using static SOA_CA1_DylanSmyth.Components.PlayerProfileFormatting
@inject ClashRoyaleApi RoyaleApi

<PageTitle>Clash Royale - Player profile</PageTitle>

<main class="workspace game-page royale-page">
    <header class="game-hero royale-hero">
        <div class="game-hero-copy">
            <div class="eyebrow">PLAYER PROFILE</div>
            <h1>Clash Royale</h1>
            <p>Explore arena progress, battle records and your current deck.</p>
        </div>
        <img class="game-hero-image" src="/clash-royale-kings.png" alt="The blue and red kings from Clash Royale" />
    </header>

    <section class="lookup-panel">
        <form @onsubmit="LoadPlayerAsync" @onsubmit:preventDefault>
            <label class="field-label" for="player-tag">Player tag</label>
            <div class="lookup-row">
                <span class="method-tag">#</span>
                <input id="player-tag" class="endpoint-input" @bind="playerTag" placeholder="2ABC123" />
                <button class="connect-button" disabled="@isLoading">
                    @(isLoading ? "Loading..." : player is null ? "Find player" : "Refresh profile")
                </button>
            </div>
        </form>

        @if (errorMessage is not null)
        {
            <div class="error-message" role="alert">@errorMessage</div>
        }
    </section>

    @if (player is { } profile)
    {
        <section class="profile-content">
            <article class="profile-banner">
                <div class="player-identity">
                    <div class="player-avatar">@GetInitials(GetText(profile, "name"))</div>
                    <div class="player-name">
                        @GetText(profile, "name")
                        <span>@GetText(profile, "tag")</span>
                    </div>
                </div>
                <div class="banner-badge"><small>ARENA</small><strong>@GetNestedText(profile, "arena", "name")</strong></div>
                <div class="banner-badge"><small>CLAN</small><strong>@GetNestedText(profile, "clan", "name")</strong></div>
            </article>

            <section class="stats-grid profile-stats" aria-label="Player stats">
                <div class="stat"><span>Trophies</span><strong>@GetText(profile, "trophies")</strong></div>
                <div class="stat"><span>Personal best</span><strong>@GetText(profile, "bestTrophies")</strong></div>
                <div class="stat"><span>Wins</span><strong>@GetText(profile, "wins")</strong></div>
                <div class="stat"><span>Battles</span><strong>@GetText(profile, "battleCount")</strong></div>
            </section>

            <div class="profile-columns">
                <article class="data-panel">
                    <h2>Battle record</h2>
                    <div class="detail-grid">
                        <div class="detail-row"><span>Three crown wins</span><strong>@GetText(profile, "threeCrownWins")</strong></div>
                        <div class="detail-row"><span>Challenge max wins</span><strong>@GetText(profile, "challengeMaxWins")</strong></div>
                        <div class="detail-row"><span>Tournament cards won</span><strong>@GetText(profile, "tournamentCardsWon")</strong></div>
                        <div class="detail-row"><span>Donations</span><strong>@GetText(profile, "donations")</strong></div>
                    </div>

                    @if (profile.TryGetProperty("clan", out var clan))
                    {
                        <div class="clan-card">
                            <span class="clan-emblem">*</span>
                            <div><strong>@GetText(clan, "name")</strong><small>@GetText(clan, "tag")</small></div>
                            <span class="role-chip">@GetText(profile, "role")</span>
                        </div>
                    }

                    @if (profile.TryGetProperty("badges", out var badges) && badges.ValueKind == JsonValueKind.Array)
                    {
                        <div class="detail-section">
                            <h3>Badges</h3>
                            <div class="collection-controls">
                                <input aria-label="Search badges" placeholder="Search badges" @bind="badgeSearch" @bind:event="oninput" />
                                <select aria-label="Sort badges" @bind="badgeSort"><option value="name">Name A to Z</option><option value="level">Level high to low</option></select>
                            </div>
                            <div class="item-list">
                                @foreach (var badge in FilterItems(badges, badgeSearch, badgeSort).Take(6))
                                {
                                    <div class="level-row">
                                        <span>@GetText(badge, "name")</span>
                                        <strong>@GetText(badge, "level")</strong>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </article>

                @if (profile.TryGetProperty("currentDeck", out var deck) && deck.ValueKind == JsonValueKind.Array)
                {
                    <article class="data-panel">
                        <div class="panel-heading"><h2>Current deck</h2><span>@deck.GetArrayLength() cards</span></div>
                        <div class="deck-grid">
                            @foreach (var card in deck.EnumerateArray().OrderBy(card => GetText(card, "name")))
                            {
                                <div class="deck-card">
                                    <span class="card-cost">@GetText(card, "elixirCost")</span>
                                    <div class="deck-card-mark">@GetInitials(GetText(card, "name"))</div>
                                    <strong>@GetText(card, "name")</strong>
                                    <small>Level @GetNormalizedLevel(card) / 16</small>
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>

            @if (profile.TryGetProperty("cards", out var cards) && cards.ValueKind == JsonValueKind.Array)
            {
                <article class="data-panel card-collection-panel">
                    <div class="panel-heading"><h2>Card collection</h2><span>@FilterCards(cards).Count() / @cards.GetArrayLength() cards</span></div>
                    <div class="collection-controls">
                        <input aria-label="Search card collection" placeholder="Search cards" @bind="cardSearch" @bind:event="oninput" />
                        <select aria-label="Sort card collection" @bind="cardSort"><option value="name">Name A to Z</option><option value="level">Level high to low</option><option value="elixir">Elixir high to low</option></select>
                        <select aria-label="Filter card rarity" @bind="cardRarity"><option value="all">All rarities</option><option value="common">Common</option><option value="rare">Rare</option><option value="epic">Epic</option><option value="legendary">Legendary</option><option value="champion">Champion</option></select>
                        <select aria-label="Filter card levels" @bind="minimumCardLevel"><option value="0">Any level</option><option value="11">Level 11+</option><option value="13">Level 13+</option><option value="15">Level 15+</option><option value="16">Level 16</option></select>
                        <select aria-label="Maximum elixir cost" @bind="maximumElixir"><option value="10">Any cost</option><option value="3">3 or less</option><option value="4">4 or less</option><option value="5">5 or less</option></select>
                    </div>
                    <div class="card-collection-grid">
                        @foreach (var card in FilterCards(cards))
                        {
                            <div class="collection-card">
                                <div class="collection-card-top"><strong>@GetText(card, "name")</strong><span>@GetText(card, "rarity")</span></div>
                                <div class="collection-card-meta">
                                    <span>Level <strong>@GetNormalizedLevel(card)</strong> / 16</span>
                                    <span>@GetText(card, "elixirCost") elixir</span>
                                </div>
                            </div>
                        }
                    </div>
                    @if (!FilterCards(cards).Any())
                    {
                        <p class="muted-note">No cards match these search and filter settings.</p>
                    }
                </article>
            }
        </section>
    }
    else if (!isLoading && errorMessage is null)
    {
        <div class="game-empty">
            <strong>Look up your player profile</strong>
            <span>Enter a player tag above to see trophies, battle stats and your current deck.</span>
        </div>
    }
</main>

@code {
    private string playerTag = string.Empty;
    private JsonElement? player;
    private string? errorMessage;
    private bool isLoading;
    private string badgeSearch = string.Empty, badgeSort = "name";
    private string cardSearch = string.Empty, cardSort = "name", maximumElixir = "10";
    private string cardRarity = "all", minimumCardLevel = "0";

    private static IEnumerable<JsonElement> FilterItems(JsonElement items, string search, string sort)
    {
        var filtered = items.EnumerateArray()
            .Where(item => GetText(item, "name").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase));
        return sort == "level"
            ? filtered.OrderByDescending(item => int.TryParse(GetText(item, "level"), out var level) ? level : 0).ThenBy(item => GetText(item, "name"))
            : filtered.OrderBy(item => GetText(item, "name"));
    }

    private IEnumerable<JsonElement> FilterCards(JsonElement cards)
    {
        var maxCost = int.TryParse(maximumElixir, out var parsed) ? parsed : 10;
        var minLevel = int.TryParse(minimumCardLevel, out var minimum) ? minimum : 0;
        var filtered = cards.EnumerateArray()
            .Where(card => GetText(card, "name").Contains(cardSearch.Trim(), StringComparison.OrdinalIgnoreCase))
            .Where(card => cardRarity == "all" || GetText(card, "rarity").Equals(cardRarity, StringComparison.OrdinalIgnoreCase))
            .Where(card => GetNormalizedLevel(card) >= minLevel)
            .Where(card => !int.TryParse(GetText(card, "elixirCost"), out var cost) || cost <= maxCost);
        return cardSort switch
        {
            "level" => filtered.OrderByDescending(GetNormalizedLevel).ThenBy(card => GetText(card, "name")),
            "elixir" => filtered.OrderByDescending(card => int.TryParse(GetText(card, "elixirCost"), out var cost) ? cost : -1).ThenBy(card => GetText(card, "name")),
            _ => filtered.OrderBy(card => GetText(card, "name"))
        };
    }

    private static int GetNormalizedLevel(JsonElement card)
    {
        if (!int.TryParse(GetText(card, "level"), out var level)) return 0;
        return int.TryParse(GetText(card, "maxLevel"), out var maxLevel) ? level + (16 - maxLevel) : level;
    }

    private async Task LoadPlayerAsync()
    {
        errorMessage = null;
        player = null;
        isLoading = true;

        try
        {
            player = await RoyaleApi.GetPlayerAsync(playerTag);
        }
        catch (Exception exception) when (exception is InvalidOperationException or ArgumentException or HttpRequestException or TaskCanceledException)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

}
